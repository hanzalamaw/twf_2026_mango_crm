# Build-time only (npm run build). Restart/rebuild after changes.

# REST API — use full URL in production when frontend and API are on different hosts/ports:
# VITE_API_URL=https://api.yourdomain.com/api
#
# Same-host deploy (Apache/nginx proxies /api to Node): leave unset or use /api
# and ensure /socket.io is proxied too (see README).
# VITE_API_URL=/api

# Optional: explicit Socket.IO origin when API URL is relative (/api)
# VITE_SOCKET_URL=https://api.yourdomain.com

# Socket.IO path on server (default /api/socket.io — same prefix as API proxy)
# VITE_SOCKET_PATH=/api/socket.io

# Set to true temporarily to log socket connect errors in the browser console
# VITE_DEBUG_SOCKETS=true
